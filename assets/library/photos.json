---
layout: null
---
{%- assign image_extensions = '.jpg,.jpeg,.png,.webp,.gif,.avif' | split: ',' -%}
{%- assign files = site.static_files | sort_natural: 'path' -%}
{%- assign separator = '' -%}
[
{%- for file in files -%}
  {%- assign directory = file.path | slice: 0, 16 -%}
  {%- assign extension = file.extname | downcase -%}
  {%- assign filename = file.path | remove_first: '/assets/library/' -%}
  {%- if directory == '/assets/library/' and image_extensions contains extension -%}
    {%- unless filename contains '/' -%}
    {{- separator -}}{{- filename | jsonify -}}
    {%- assign separator = ',' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
]
